# DAIW Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# AI API Keys (set at least one)
# ============================================
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# ============================================
# AI Provider Configuration
# ============================================
AI_PROVIDER=anthropic  # or openai
AI_MODEL=claude-3-5-sonnet-20241022
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# ============================================
# Ableton OSC Configuration
# ============================================
OSC_DAEMON_HOST=127.0.0.1
OSC_DAEMON_PORT=65432
ABLETON_OSC_SEND_PORT=11000
ABLETON_OSC_RECEIVE_PORT=11001

# ============================================
# MIDI Configuration
# ============================================
MIDI_OUTPUT_PORT=  # Leave empty for auto-detect
MIDI_INPUT_PORT=   # Leave empty for auto-detect

# ============================================
# CollabNet Server Configuration
# ============================================
COLLABNET_SERVER=ws://localhost:8765
COLLABNET_USERNAME=Producer
COLLABNET_COLOR=#00ff00

# ============================================
# DAIW Window Configuration
# ============================================
DAIW_MODE=idle
DAIW_ALWAYS_ON_TOP=true
DAIW_CLICK_THROUGH=false
DAIW_START_POSITION_X=100
DAIW_START_POSITION_Y=100

# ============================================
# Feature Settings
# ============================================
# YouTube
YOUTUBE_DOWNLOAD_DIR=  # Leave empty for temp dir
YOUTUBE_MAX_CACHE=5

# STEM Separator
STEM_MODEL=htdemucs  # or htdemucs_ft, htdemucs_6s
STEM_OUTPUT_DIR=  # Leave empty for temp dir

# Humming Detector
HUMMING_SAMPLE_RATE=44100
HUMMING_SENSITIVITY=0.5

# ============================================
# Development Settings
# ============================================
DEBUG=false
LOG_LEVEL=INFO
